# Vercel Environment Variables — Local Development Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored automatically by Vercel.

# Your Google Gemini API Key (get it at https://aistudio.google.com)
# IMPORTANT: Never commit this file or the actual .env.local to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here

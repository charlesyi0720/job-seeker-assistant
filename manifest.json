{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "description": "__MSG_app_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg"
    },
    "default_title": "__MSG_app_name__"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html",
    "default_title": "__MSG_sidepanel_title__"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.seek.com.au/*",
        "*://*.linkedin.com/*",
        "*://*/*"
      ],
      "js": [
        "content/scrapers/scraper-manager.js",
        "content/scrapers/seek-scraper.js",
        "content/scrapers/linkedin-scraper.js",
        "content/scrapers/generic-scraper.js",
        "content/dom-injector.js",
        "content/content-entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.seek.com.au/*",
    "*://*.linkedin.com/*",
    "*://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://cdn.tailwindcss.com https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://*.vercel.app http://localhost:3000 https://*.supabase.co; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/custom.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
